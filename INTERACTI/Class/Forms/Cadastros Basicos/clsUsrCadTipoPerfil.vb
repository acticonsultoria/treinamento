    Public Sub LoadDados(ByVal lCodigo As Long,
                         ByVal txtDescricao As MaskedEditBox,
                         ByVal cboTipoCalculo As UIComboBox,
                         ByVal cboAtivo As UIComboBox,
                         ByVal cboQuantidadeMedidas As UIComboBox,
                         ByVal txtDescricaoMedida1 As MaskedEditBox,
                         ByVal txtDescricaoMedida2 As MaskedEditBox,
                         ByVal txtDescricaoMedida3 As MaskedEditBox,
                         ByVal txtDescricaoMedida4 As MaskedEditBox)

        'Variaveis Locais
        Dim oSqlParameter(0) As SqlParameter
        Dim oSqlDataReader As SqlDataReader
        Dim i As Integer = 0

        Try

            'Seta Parametros - Código
            oSqlParameter(i) = New SqlParameter
            oSqlParameter(i).ParameterName = "codigo"
            oSqlParameter(i).Direction = ParameterDirection.Input
            oSqlParameter(i).SqlDbType = SqlDbType.BigInt
            oSqlParameter(i).Value = lCodigo : i += 1 : ReDim Preserve oSqlParameter(i)

            'Seta Parametros - Código Empresa
            oSqlParameter(i) = New SqlParameter
            oSqlParameter(i).ParameterName = "codigo_empresa"
            oSqlParameter(i).Direction = ParameterDirection.Input
            oSqlParameter(i).SqlDbType = SqlDbType.SmallInt
            oSqlParameter(i).Value = goUsuario.iEmpresa

            'Executa Query
            oSqlDataReader = ExecuteReader(goDatabase.sConnection, CommandType.StoredProcedure, "sp_select_cadastro_basico_tipo_perfil_dados", oSqlParameter)

            While oSqlDataReader.Read

                txtDescricao.Text = oSqlDataReader("descricao")
                cboTipoCalculo.SelectedValue = oSqlDataReader("codigo_tipo_calculo")
                cboAtivo.SelectedValue = oSqlDataReader("ativo")
                cboQuantidadeMedidas.SelectedValue = oSqlDataReader("quantidade_medidas")
                txtDescricaoMedida1.Text = oSqlDataReader("descricao_medida1")
                txtDescricaoMedida2.Text = oSqlDataReader("descricao_medida2")
                txtDescricaoMedida3.Text = oSqlDataReader("descricao_medida3")
                txtDescricaoMedida4.Text = oSqlDataReader("descricao_medida4")

            End While

            'Fecha o SQLDataReader
            If oSqlDataReader.IsClosed = False Then oSqlDataReader.Close()

        Catch SqlEx As SqlException
            Throw SqlEx
        Catch ex As Exception
            Throw ex
        End Try

    End Sub

