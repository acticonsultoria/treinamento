Imports System.Data
Imports System.Data.SqlClient
Imports INTERACTI.SQLHelper
Imports Janus.Windows.GridEX

Public Class clsUsrCadAutotextoOperacao

#Region "::: VARIAVEIS :::"

    'Variaveis da Classe
    Private iCodigoOperacao As Integer
    Private sDescricao As String
    Private sAutotexto As String
    Private sAutotextoIdioma As String
    Private bAtivo As Boolean
    Private iCodigo As Integer

#End Region

#Region "::: PROPERTIE :::"

    Public Property CodigoOperacao() As Integer
        Get
            Return iCodigoOperacao
        End Get
        Set(ByVal value As Integer)
            iCodigoOperacao = value
        End Set
    End Property

    Public Property Descricao() As String
        Get
            Return sDescricao
        End Get
        Set(ByVal value As String)
            sDescricao = value
        End Set
    End Property

    Public Property Autotexto() As String
        Get
            Return sAutotexto
        End Get
        Set(ByVal value As String)
            sAutotexto = value
        End Set
    End Property

    Public Property AutotextoIdioma() As String
        Get
            Return sAutotextoIdioma
        End Get
        Set(ByVal value As String)
            sAutotextoIdioma = value
        End Set
    End Property

    Public Property Ativo() As Boolean
        Get
            Return bAtivo
        End Get
        Set(ByVal value As Boolean)
            bAtivo = value
        End Set
    End Property

    Public Property Codigo() As Integer
        Get
            Return iCodigo
        End Get
        Set(ByVal value As Integer)
            iCodigo = value
        End Set
    End Property

