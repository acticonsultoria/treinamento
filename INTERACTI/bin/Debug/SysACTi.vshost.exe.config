<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="SysACTi.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <applicationSettings>
        <SysACTi.My.MySettings>
            <setting name="SysACTi_br_com_ginfes_homologacao_ServiceGinfesImplService"
                serializeAs="String">
                <value>https://homologacao.ginfes.com.br//ServiceGinfesImpl</value>
            </setting>
            <setting name="SysACTi_br_com_ginfes_producao_ServiceGinfesImplService"
                serializeAs="String">
                <value>https://producao.ginfes.com.br//ServiceGinfesImpl</value>
            </setting>
            <setting name="SysACTi_br_gov_sp_fazenda_nfe_V3_AutorizacaoLote_NfeAutorizacao"
                serializeAs="String">
                <value>https://nfe.fazenda.sp.gov.br/ws/nfeautorizacao.asmx</value>
            </setting>
            <setting name="SysACTi_br_gov_sp_fazenda_nfe_V3_RetAutorizacaoLote_NfeRetAutorizacao"
                serializeAs="String">
                <value>https://nfe.fazenda.sp.gov.br/ws/nferetautorizacao.asmx</value>
            </setting>
            <setting name="SysACTi_WebServiceEmbraer_ImportDanfeXMLStringSoap_SyncService"
                serializeAs="String">
                <value>https://pidev.embraer.com.br:50001/XISOAPAdapter/MessageServlet?channel=LANMAR:LANMAR_P7D:CC_LANMAR_SOAP&amp;version=3.0&amp;Sender.Party=http%3A%2F%2Fsap.com%2Fxi%2FXI%3AXIParty%3ALANMAR&amp;Sender.Service=LANMAR_P7D&amp;Interface=urn%3Aembraer-com%3ADados_NotaFiscal_LANMAR%5EImportDanfeXMLStringSoap_Sync</value>
            </setting>
            <setting name="SysACTi_WebBCB_FachadaWSSGSService" serializeAs="String">
                <value>https://www3.bcb.gov.br/wssgs/services/FachadaWSSGS</value>
            </setting>
            <setting name="SysACTi_br_gov_fazenda_nfe_ConsultaDFe_NFeDistribuicaoDFe"
                serializeAs="String">
                <value>https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx</value>
            </setting>
            <setting name="SysACTi_br_gov_ba_sefaz_nfe_ConsultaNF_NfeConsulta"
                serializeAs="String">
                <value>https://nfe.sefaz.ba.gov.br/webservices/NfeConsulta/NfeConsulta.asmx</value>
            </setting>
            <setting name="SysACTi_br_gov_pr_fazenda_nfe_ConsultaNF_NfeConsulta3"
                serializeAs="String">
                <value>https://nfe.fazenda.pr.gov.br/nfe/NFeConsulta3</value>
            </setting>
            <setting name="SysACTi_WSEmbraer_V2_ImportDanfeXMLStringSoap_SyncService"
                serializeAs="String">
                <value>http://sappap:55100/XISOAPAdapter/MessageServlet?senderParty=LANMAR&amp;senderService=LANMAR_PIP&amp;receiverParty=&amp;receiverService=&amp;interface=ImportDanfeXMLStringSoap_Sync&amp;interfaceNamespace=urn%3Aembraer-com%3ADados_NotaFiscal_LANMAR</value>
            </setting>
            <setting name="SysACTi_br_gov_fazenda_nfe_evento_NFeRecepcaoEvento4"
                serializeAs="String">
                <value>https://www.nfe.fazenda.gov.br/NFeRecepcaoEvento4/NFeRecepcaoEvento4.asmx</value>
            </setting>
        </SysACTi.My.MySettings>
    </applicationSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="office" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Vbe.Interop" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Office.Interop.Excel" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Office.Interop.SmartTag" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1"/></startup></configuration>
